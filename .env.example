# ---- Web (Vite only exposes VITE_ prefixed vars to client code) ----
VITE_APP_TITLE=template-web-fullstack
# In production the web app calls the API through the nginx /api proxy.
VITE_API_BASE_URL=/api

# ---- API (server-side only; never prefix with VITE_) ----
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/template_web
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
APP_VERSION=0.0.0
# Path to SQL migration files (defaults to ./migrations relative to cwd).
MIGRATIONS_DIR=./migrations
