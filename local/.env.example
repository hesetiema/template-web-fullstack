# Copy to local/.env. Only one variable controls the local Forgejo instance.
# Set to false if you want the Forgejo signup page open (default: true, invite-only).
DISABLE_REGISTRATION=true

# NOTE: the runner's uuid/token do NOT go here. They are pasted into
# local/runner-config.yml after clicking "Create new runner" in the Forgejo UI.
# See LOCAL-GUIDE.md step 3.
